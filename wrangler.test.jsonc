{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compute-worker-test",
  "main": "src/guard.js",
  "compatibility_date": "2026-08-14",
  "durable_objects": {"bindings": [{"name": "CENTER_GATE", "class_name": "CenterGate"}]},
  "exports": {"CenterGate": {"type": "durable-object", "storage": "sqlite"}},
  "vars": {
    "RATE_LIMIT_PER_MIN": "200",
    "MAX_RUNTIME_SECONDS": "3600",
    "KAGGLE_MCP_BRIDGE_URL": "https://bridge.test/dispatch",
    "KAGGLE_MCP_AUTH": "test-auth",
    "KAGGLE_API_TOKEN": "test-kaggle-token"
  }
}