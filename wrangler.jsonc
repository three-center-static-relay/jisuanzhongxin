{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compute-worker",
  "main": "src/admin-entry.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "triggers": {"crons": ["17 4 * * *"]},
  "workflows": [{"name":"modelscope-studio-lite-runner","binding":"MODELSCOPE_STUDIO_WORKFLOW","class_name":"ModelScopeStudioLiteWorkflow"}],
  "build": {"command": "node tests/capability-manifest-contract.mjs && node tests/openeo-intelligence-handoff.mjs && node tests/predeploy.mjs && node tests/predeploy-circleci.mjs && node tests/google-cloud-credential-unification.mjs && node tests/model-library.mjs && node tests/universal-model-library.mjs && node tests/industry-specialist-recipes.mjs && node tests/commercial-spatial-fusion.mjs && node tests/geospatial-commercial-domain.mjs && node tests/commercial-spatial-model-dispatch.mjs && node tests/kaggle-package-audit.mjs && node tests/medical-imaging-toolkit.mjs && node tests/benchmark-library.mjs && node tests/admin-context-contract.mjs && node tests/modal-provider.mjs && node tests/provider-autonomy-contract.mjs && node tests/provider-route-truth.mjs && node tests/provider-truth-semantics.mjs && node tests/modal-execution-guard.mjs && node tests/baidu-control-guard.mjs && node tests/benchmark-route-guard.mjs && node tests/modal-public-health-cache.mjs && node tests/baidu-terminal-detail-contract.mjs && node tests/baidu-bootstrap-sentinel-contract.mjs && node tests/baidu-p24b-final-acceptance-contract.mjs && node tests/baidu-sdk039-selftest-contract.mjs && node tests/baidu-p24c-sdk039-acceptance-contract.mjs && node tests/commercial-spatial-signal.mjs && node tests/kaggle-model-result-envelope.mjs && node tests/kaggle-robust-site-e2e-contract.mjs && node tests/modelscope-provider.mjs && node tests/modelscope-runtime-alert-contract.mjs && node tests/modelscope-live-selftest-contract.mjs && node tests/modelscope-inference-contract.mjs && node tests/modelscope-studio-cpu-runner-contract.mjs && node tests/modelscope-studio-lite-cpu-runner-contract.mjs && node tests/modelscope-studio-workflow-contract.mjs && node tests/modelscope-deploy-isolation-contract.mjs && node tests/huawei-functiongraph-contract.mjs && node tests/huawei-functiongraph-live-e2e.mjs"},
  "durable_objects": {"bindings": [{"name":"CENTER_GATE","class_name":"CenterGate"}]},
  "exports": {"CenterGate": {"type":"durable-object","storage":"sqlite"}},
  "vars": {"RATE_LIMIT_PER_MIN":"30","MAX_RUNTIME_SECONDS":"3600"},
  "observability": {"enabled":true,"logs":{"enabled":true,"head_sampling_rate":1},"traces":{"enabled":true,"head_sampling_rate":0.02}}
}
