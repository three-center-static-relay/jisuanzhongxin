{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compute-worker",
  "main": "src/admin-entry.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "triggers": {"crons": ["17 4 * * *"]},
  "build": {"command": "node tests/predeploy.mjs && node tests/predeploy-circleci.mjs && node tests/google-cloud-credential-unification.mjs && node tests/model-library.mjs && node tests/universal-model-library.mjs && node tests/industry-specialist-recipes.mjs && node tests/kaggle-package-audit.mjs && node tests/medical-imaging-toolkit.mjs && node tests/benchmark-library.mjs && node tests/admin-context-contract.mjs && node tests/modal-provider.mjs && node tests/provider-autonomy-contract.mjs && node tests/provider-route-truth.mjs"},
  "durable_objects": {"bindings": [{"name": "CENTER_GATE", "class_name": "CenterGate"}]},
  "exports": {"CenterGate": {"type":"durable-object","storage":"sqlite"}},
  "vars": {"RATE_LIMIT_PER_MIN": "30", "MAX_RUNTIME_SECONDS": "3600"}
}
