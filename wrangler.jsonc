{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compute-worker",
  "main": "src/admin-entry.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "triggers": {"crons": ["17 4 * * *", "* * * * *"]},
  "build": {"command": "node tests/predeploy-circleci.mjs"},
  "durable_objects": {"bindings": [{"name":"CENTER_GATE","class_name":"CenterGate"}]},
  "exports": {"CenterGate": {"type":"durable-object","storage":"sqlite"}},
  "vars": {"RATE_LIMIT_PER_MIN":"30","MAX_RUNTIME_SECONDS":"3600"}
}
