{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compute-worker",
  "main": "src/admin-entry.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "triggers": {"crons": ["17 4 * * *"]},
  "workflows": [{"name":"modelscope-studio-lite-runner","binding":"MODELSCOPE_STUDIO_WORKFLOW","class_name":"ModelScopeStudioLiteWorkflow"}],
  "durable_objects": {"bindings": [{"name":"CENTER_GATE","class_name":"CenterGate"}]},
  "exports": {"CenterGate": {"type":"durable-object","storage":"sqlite"}},
  "vars": {"RATE_LIMIT_PER_MIN":"30","MAX_RUNTIME_SECONDS":"3600"},
  "observability": {"enabled":true,"logs":{"enabled":true,"head_sampling_rate":1},"traces":{"enabled":true,"head_sampling_rate":0.02}}
}
